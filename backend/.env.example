# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file (Section 16: secrets management).

APP_NAME="SentinelScan Cloud"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://sentinelscan_cloud:sentinelscan_cloud@localhost:5432/sentinelscan_cloud_dev
DATABASE_URL_SYNC=postgresql+psycopg2://sentinelscan_cloud:sentinelscan_cloud@localhost:5432/sentinelscan_cloud_dev

JWT_SECRET_KEY=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=sentinelscan-cloud-reports

JOB_QUEUE_BROKER_URL=redis://localhost:6379/0
